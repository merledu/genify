/Pg 10 0 R
/K [3]
>>
endobj
332 0 obj
<<
/Type /StructElem
/S /P
/P 800 0 R
/E (Punctuation: Punctuation marks like periods, commas, and exclamation marks are also treated as individual tokens.)
/Pg 10 0 R
/K [4]
>>
endobj
333 0 obj
<<
/Type /StructElem
/S /P
/P 801 0 R
